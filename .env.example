# Noms des variables uniquement : renseignez les valeurs dans Vercel / votre .env local (jamais dans Git).
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# Conservées car la fonctionnalité existait (exigées au démarrage)
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
MONGO_URI=
MONGO_DB=
PORT=3000
NODE_ENV=development
# Optionnel : e-mails (vérifiés dans Auth0) qui obtiennent le rôle Admin, séparés par des virgules
ADMIN_EMAILS=
